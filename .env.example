# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.devsyndicate.co.in

# ── Lead notifications ────────────────────────────────────────────
# Where new hackathon requests are emailed. Defaults to dsdevsyndicate@gmail.com.
CONTACT_EMAIL=
# Any SMTP provider works. For Gmail, use smtp.gmail.com:465 with an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Optional "From" header, e.g. Dev Syndicate Website <dsdevsyndicate@gmail.com>
SMTP_FROM=

# ── Lead storage ──────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Railway, RDS…). Run `npm run db:setup` once.
# Without it, development stores leads in .data/leads.json and production only emails them.
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS.
DATABASE_SSL=

# ── Admin dashboard (/admin) ──────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Generate with: npm run admin:hash -- "a long password"
ADMIN_PASSWORD_HASH=
# Plain-text alternative to the hash (not recommended in production)
ADMIN_PASSWORD=

# Optional salt for hashing submitter IPs (defaults to SESSION_SECRET)
IP_HASH_SALT=
