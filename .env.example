# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.devsyndicate.co.in

# ── Lead notifications ────────────────────────────────────────────
# Where new hackathon requests are emailed. Defaults to dsdevsyndicate@gmail.com.
CONTACT_EMAIL=
# Any SMTP provider works. For Gmail, use smtp.gmail.com:465 with an App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# "From" header. Set it whenever SMTP_USER isn't itself an email address (Resend, SES, Postmark…).
# Recommended: a mailbox on the domain, which already uses Zoho Mail (smtp.zoho.in:465), e.g.
# Dev Syndicate Website <website@devsyndicate.co.in>
SMTP_FROM=

# ── Lead storage ──────────────────────────────────────────────────
# Postgres connection string (Neon, Supabase, Railway, RDS…). Run `npm run db:setup` once, and again
# before deploying an upgrade that adds columns or tables.
# Without it, development stores leads in .data/leads.json and production only emails them.
# Production needs BOTH this and SMTP_* — storage alone means nobody is notified of new leads.
DATABASE_URL=
# Set to "disable" for a local Postgres without TLS.
DATABASE_SSL=

# ── Admin dashboard (/admin) ──────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 48`. Changing it signs everyone out.
SESSION_SECRET=
# The primary admin signs in with this username and the password behind ADMIN_PASSWORD_HASH.
# Both are required; additional admins are created in the admin under Team.
ADMIN_USERNAME=
# Generate with: npm run admin:hash -- "a long password"
ADMIN_PASSWORD_HASH=
# Plain-text alternative to the hash (not recommended in production)
ADMIN_PASSWORD=

# Optional salt for hashing submitter IPs (defaults to SESSION_SECRET)
IP_HASH_SALT=

# ── Search engines ────────────────────────────────────────────────
# HTML-tag verification tokens (content="..." value only). Rendered as <meta> tags when set.
# Google Search Console → Add property → URL prefix → HTML tag.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Add site → HTML Meta Tag (msvalidate.01).
BING_SITE_VERIFICATION=
